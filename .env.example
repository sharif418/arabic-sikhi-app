# Database (PostgreSQL — required for production)
DATABASE_URL=postgresql://user:password@localhost:5432/arabic_sikhi

# Session — MUST be a strong random string (at least 32 bytes)
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-strong-random-secret

# SMTP — Required for email verification (OTP)
# Ask your email provider for these details
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="আরবি শিখি <noreply@arabicsikhi.com>"

